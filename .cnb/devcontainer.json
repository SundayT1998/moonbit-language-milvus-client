{
  "name": "milvus-client (MoonBit)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "postCreateCommand": "moon version --all || curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.moon/bin:${containerEnv:PATH}"
  }
}
